rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: Allow read and write for profile creation, Google auth & updates
    match /users/{userId} {
      allow read, write: if true;
    }

    // Campaigns collection: Anyone can browse campaigns, creators can create & update
    match /campaigns/{campaignId} {
      allow read, write: if true;
    }

    // Task submissions collection
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Transactions and wallet ledgers
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
    match /walletTransactions/{transactionId} {
      allow read, write: if true;
    }

    // Withdrawals queue
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // Referrals and admin action logs
    match /referrals/{referralId} {
      allow read, write: if true;
    }
    match /adminActionLogs/{logId} {
      allow read, write: if true;
    }

    // Social accounts and fraud signals
    match /social_accounts/{accountId} {
      allow read, write: if true;
    }
    match /fraud_signals/{signalId} {
      allow read, write: if true;
    }

    // Catch-all document access for app features
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
